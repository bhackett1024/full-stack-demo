{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threadline-replay",
  "main": "apps/worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./dist", "binding":"ASSETS", "not_found_handling":"single-page-application", "run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"threadline-replay","database_id":"609f651c-db8a-4ffd-bb7b-30e2ada5a413","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"threadline-replay-artifacts"}],
  "durable_objects": {"bindings":[{"name":"REPLAY_SESSIONS","class_name":"ReplaySession"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ReplaySession"]}],
  "workflows": [{"name":"threadline-investigation","binding":"INVESTIGATIONS","class_name":"InvestigationWorkflow"},{"name":"threadline-preparation","binding":"PREPARATION","class_name":"PreparationWorkflow"}],
  "vars": {"PUBLIC_DEMO":"true","MODEL_ID":"claude-sonnet-4-6","PUBLIC_ORIGIN":"https://full-stack-demo.replay.io"},
  "observability": {"enabled":true}
}
